{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "maintainers": [
    "P4ST4S"
  ],
  "environmentVariables": {
    "schema": {
      "type": "object",
      "properties": {
        "MCP_AUDIT_SIGNING_SECRET": {
          "type": "string",
          "minLength": 1,
          "description": "Preferred HMAC-SHA256 signing secret, required when audit.sign is enabled"
        },
        "AUDIT_SECRET": {
          "type": "string",
          "minLength": 1,
          "description": "Legacy fallback for MCP_AUDIT_SIGNING_SECRET"
        }
      },
      "additionalProperties": false
    },
    "placeholderArguments": [
      "MCP_AUDIT_SIGNING_SECRET",
      "AUDIT_SECRET"
    ]
  }
}
